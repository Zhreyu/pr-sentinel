# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr_sentinel

# Redis
REDIS_URL=redis://localhost:6379

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional workspace name used during first-run bootstrap
DEFAULT_WORKSPACE_NAME=

# Session (generate with: openssl rand -hex 32)
SESSION_SECRET=your_64_char_hex_secret_here

# AI Provider (bootstrap asks for one of these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Bootstrap fills these after GitHub App creation
GITHUB_APP_ID=
GITHUB_APP_SLUG=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# OAuth uses the GitHub App client credentials by default
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

NODE_ENV=production
