# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr_sentinel

# Redis
REDIS_URL=redis://localhost:6379

# GitHub OAuth (Create at: https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID=your_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# GitHub App (Create at: https://github.com/settings/apps)
GITHUB_APP_ID=your_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret

# AI Provider (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=...

# Session (generate with: openssl rand -base64 32)
SESSION_SECRET=your_32_char_or_longer_secret_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
